{
  "version": 1,
  "repositories": {
    "producer": {
      "path": "/private/tmp/knowledge-query-evidence/live-pilot/producer",
      "url": "https://example.invalid/producer",
      "scope": [
        "app.py",
        "check.py"
      ],
      "project": "/private/tmp/knowledge-query-evidence/live-pilot/project-producer"
    },
    "consumer": {
      "path": "/private/tmp/knowledge-query-evidence/live-pilot/consumer",
      "url": "https://example.invalid/consumer",
      "scope": [
        "app.py",
        "check.py"
      ],
      "project": "/private/tmp/knowledge-query-evidence/live-pilot/project-consumer"
    }
  },
  "principals": {
    "operator": {
      "manage": true,
      "goals": [
        "exchange"
      ],
      "repositories": {
        "producer": [
          "source",
          "query",
          "publish"
        ],
        "consumer": [
          "source",
          "query",
          "publish"
        ]
      }
    },
    "reader": {
      "manage": false,
      "goals": [
        "exchange"
      ],
      "repositories": {
        "producer": [
          "source",
          "query",
          "publish"
        ],
        "consumer": [
          "source",
          "query",
          "publish"
        ]
      }
    },
    "restricted": {
      "manage": false,
      "goals": [
        "exchange"
      ],
      "repositories": {
        "producer": [
          "source",
          "query",
          "publish"
        ],
        "consumer": []
      }
    }
  },
  "checks": {
    "producer-check": {
      "repositories": [
        "producer"
      ],
      "cwd_repository": "producer",
      "argv": [
        "/private/tmp/knowledge-contract-venv/bin/python",
        "-B",
        "check.py"
      ]
    },
    "consumer-check": {
      "repositories": [
        "consumer"
      ],
      "cwd_repository": "consumer",
      "argv": [
        "/private/tmp/knowledge-contract-venv/bin/python",
        "-B",
        "check.py"
      ]
    },
    "exchange-check": {
      "repositories": [
        "producer",
        "consumer"
      ],
      "cwd_repository": "producer",
      "argv": [
        "/private/tmp/knowledge-contract-venv/bin/python",
        "-B",
        "/private/tmp/knowledge-query-evidence/live-pilot/exchange-check.py"
      ]
    }
  }
}
