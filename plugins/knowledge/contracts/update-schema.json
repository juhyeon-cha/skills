{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "decisions": {
      "type": "object",
      "properties": {
        "impact": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "keep",
                  "replace",
                  "remove"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "path",
              "id",
              "action",
              "reason",
              "text",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "unlinked": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "change": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "added"
                      },
                      "after": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "after"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "removed"
                      },
                      "before": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "before"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "modified",
                          "rename-candidate"
                        ]
                      },
                      "before": {
                        "type": "string",
                        "minLength": 1
                      },
                      "after": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "before",
                      "after"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "const": "no-document-change"
              }
            },
            "required": [
              "change",
              "reason",
              "action"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "impact",
        "claims",
        "unlinked"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "update-plan"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindings": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "after": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decisions": {
          "$ref": "#/$defs/decisions"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "before_text": {
                "type": "string"
              },
              "after_text": {
                "type": "string"
              },
              "before_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "after_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "before_text",
              "after_text",
              "before_sha256",
              "after_sha256"
            ],
            "additionalProperties": false
          }
        },
        "next_bindings": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "version": {
                  "const": 1
                },
                "kind": {
                  "const": "bindings"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "snapshot": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "documents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "claims": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1
                            },
                            "evidence": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "minItems": 1,
                              "uniqueItems": true
                            }
                          },
                          "required": [
                            "id",
                            "text",
                            "evidence"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "claims",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "version",
                "kind",
                "id",
                "snapshot",
                "documents"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "kind",
        "id",
        "bindings",
        "before",
        "after",
        "decisions",
        "documents",
        "next_bindings"
      ],
      "additionalProperties": false
    }
  }
}
