{
  "description": "SessionStart: inject the always-on harness block (session-context.md) as additionalContext.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
