{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "spec": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "path",
              "claims"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "documents"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "bindings"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "claims",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "version",
        "kind",
        "id",
        "snapshot",
        "documents"
      ],
      "additionalProperties": false
    },
    "impact": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "impact"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindings": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "after": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "change": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "changes": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "const": "added"
                              },
                              "after": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "type",
                              "after"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "const": "removed"
                              },
                              "before": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "type",
                              "before"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "enum": [
                                  "modified",
                                  "rename-candidate"
                                ]
                              },
                              "before": {
                                "type": "string",
                                "minLength": 1
                              },
                              "after": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "type",
                              "before",
                              "after"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "changes"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "path",
              "sha256",
              "claims"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "unlinked_changes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "added"
                  },
                  "after": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "after"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "removed"
                  },
                  "before": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "before"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "modified",
                      "rename-candidate"
                    ]
                  },
                  "before": {
                    "type": "string",
                    "minLength": 1
                  },
                  "after": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "before",
                  "after"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "version",
        "kind",
        "id",
        "bindings",
        "before",
        "after",
        "change",
        "candidates",
        "unlinked_changes"
      ],
      "additionalProperties": false
    }
  }
}
